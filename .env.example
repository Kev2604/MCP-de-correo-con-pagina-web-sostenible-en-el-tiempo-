# Configuración SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=tu_usuario@example.com
SMTP_PASSWORD=tu_contraseña_segura
SMTP_FROM=tu_usuario@example.com
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT=30
SMTP_RETRIES=2
SMTP_RETRY_BACKOFF_SECONDS=1.0
REQUIRE_TLS=false
MAX_BODY_SIZE=1048576
MAX_HTML_SIZE=1048576
MAX_ATTACHMENT_SIZE=5242880
MAX_TOTAL_SIZE=10485760
MAX_ATTACHMENTS=5
MAX_RECIPIENTS=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.png,.jpg,.jpeg,.gif
ALLOWED_DOMAINS=
ALLOWED_RECIPIENTS=
DRY_RUN=false
LOG_LEVEL=INFO
APP_ENV=development
TEMPLATE_DIR=templates
PRIVACY_MODE=false
RUN_REAL_EMAIL_TESTS=false
