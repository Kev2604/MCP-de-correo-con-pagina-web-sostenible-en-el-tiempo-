{
  "mcpServers": {
    "correo-mcp": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--env-file",
        "C:/Users/.env",
        "mcp-correo:latest"
      ],
      "cwd": "C:/Usersmcp-correo",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "transport": "stdio"
    }
  }
}
